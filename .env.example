# --- Supabase (required) -------------------------------------------------
# Project URL and the anon / publishable key (Project Settings -> API).
# Every Supabase call happens on the server, so these need no NEXT_PUBLIC_ prefix;
# the NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY names that the
# Vercel integration sets are accepted as well.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service-role key: only used by the dead-source cron job and the takedown
# endpoint. Never expose it to the browser. Keep it server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ----------------------------------------------------------------
# Public origin, used for sitemap, share images and e-mail links.
SITE_URL=http://localhost:3000
# Where the "report this page" link goes.
REPORT_EMAIL=

# --- Upstream APIs (all optional) -----------------------------------------
# Identify yourself to Bangumi / Open Library (their API etiquette asks for it).
ZAN_USER_AGENT="zan/0.1 (+https://github.com/zjffun/zan)"
# Bangumi access token: higher limits, NSFW-aware results.
BANGUMI_ACCESS_TOKEN=
# YouTube Data API key: adds video duration and the embeddable flag. Quota-limited.
YOUTUBE_API_KEY=

# --- Operations ------------------------------------------------------------
# Bearer secret for /api/cron/check-sources (Vercel Cron sends it automatically).
CRON_SECRET=
# Bearer secret for POST /api/admin/takedown.
ADMIN_SECRET=
